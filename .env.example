# AutoLaya backend configuration
# Copy to backend/.env and fill values. Never commit backend/.env.

# ── Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=

# ── LLM (any OpenAI-compatible Chat Completions API) ──
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=4

# ── Jev teacher ───────────────────────────────────────
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
JEV_MODEL=
TYPESAFE_JEV_MODEL=jev-1.14.0
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
TYPESAFE_BASE_URL=
OPENROUTER_BASE_URL=https://openrouter.ai
JEV_TIMEOUT_SECONDS=90

# ── Laya target ───────────────────────────────────────
LAYA_ENABLED=true
LAYA_BASE_MODEL=convaiinnovations/laya-typed-decisions
LAYA_MULTI_MODEL=convaiinnovations/laya-multilingual
# Fit mode uses the Vega universal reader. Point these at local dirs when HF is unavailable.
# LAYA_FIT_MODEL=/path/to/vega-U
# LAYA_FIT_BACKBONE=/path/to/Qwen3.5-0.8B
LAYA_DEVICE=auto
LAYA_SERVE_HOST=127.0.0.1
LAYA_SERVE_PORT=8100
LAYA_API_KEY=
# LAYA_VENV_DIR=/absolute/path/to/backend/laya-venv
LAYA_TRAIN_BIN=
LAYA_SERVE_BIN=
HF_ENDPOINT=

# ── Generation ────────────────────────────────────────
GENERATION_BATCH_SIZE=20
GENERATION_MAX_ATTEMPTS=3
TEACHER_MAX_CONCURRENCY=4
EVAL_MAX_ROWS=200
JOB_WORKER_ENABLED=true

# ── GLiNER target (reserved) ──────────────────────────
GLINER_ENABLED=false
GLINER_BASE_MODEL=fastino/GLiNER2.5-Decide
GLINER_MULTI_MODEL=fastino/GLiNER2.5-multi-Decide
GLINER_DEVICE=auto
GLINER_SERVE_HOST=127.0.0.1
GLINER_SERVE_PORT=8101
# GLINER_VENV_DIR=/absolute/path/to/backend/gliner-venv

# ── Dataset / artifacts ───────────────────────────────
# Defaults are <repo>/data, <repo>/data/datasets, etc.
# DATA_DIR=/absolute/path/to/data
# DATASET_DIR=/absolute/path/to/data/datasets
# ARTIFACT_DIR=/absolute/path/to/data/artifacts
# UPLOAD_DIR=/absolute/path/to/data/uploads
